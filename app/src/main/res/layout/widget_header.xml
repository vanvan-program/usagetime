<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="26dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_title" style="@style/UsageWidgetText"
        android:layout_width="0dp" android:layout_weight="1"
        android:text="@string/usage_widget_title" android:textStyle="bold" />
    <ImageView android:id="@+id/widget_refresh" android:layout_width="28dp"
        android:layout_height="26dp" android:padding="4dp"
        android:src="@drawable/widget_refresh" android:contentDescription="@string/widget_refresh"
        android:background="?android:attr/selectableItemBackgroundBorderless" />
</LinearLayout>

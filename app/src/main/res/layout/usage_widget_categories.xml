<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" style="@style/UsageWidgetRoot" android:padding="8dp">
    <include layout="@layout/widget_header" android:layout_width="match_parent" android:layout_height="22dp" />
    <TextView android:id="@+id/widget_total" style="@style/UsageWidgetTotal"
        android:layout_height="26dp" android:text="@string/usage_widget_loading" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_chart" android:layout_width="58dp"
            android:layout_height="58dp" android:layout_marginEnd="10dp"
            android:scaleType="fitCenter" android:contentDescription="@string/widget_category_chart" />
        <LinearLayout android:id="@+id/widget_rows" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_vertical" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" style="@style/UsageWidgetText" android:visibility="gone" />
    <TextView android:id="@+id/widget_comparison" style="@style/UsageWidgetFootnote"
        android:text="@string/widget_saved_only" />
    <TextView android:id="@+id/widget_metric" style="@style/UsageWidgetFootnote"
        android:visibility="gone" android:text="@string/widget_metric" />
    <TextView android:id="@+id/widget_updated" style="@style/UsageWidgetFootnote"
        android:text="@string/widget_no_update" />
</LinearLayout>

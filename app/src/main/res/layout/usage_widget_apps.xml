<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" style="@style/UsageWidgetRoot">
    <include layout="@layout/widget_header" />
    <TextView android:id="@+id/widget_total" style="@style/UsageWidgetTotal"
        android:text="@string/usage_widget_loading" />
    <TextView android:id="@+id/widget_comparison" style="@style/UsageWidgetFootnote"
        android:text="@string/widget_saved_only" />
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:gravity="center_vertical" />
    <TextView android:id="@+id/widget_empty" style="@style/UsageWidgetText"
        android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:visibility="gone" />
    <TextView android:id="@+id/widget_metric" style="@style/UsageWidgetFootnote"
        android:text="@string/widget_metric" />
    <TextView android:id="@+id/widget_updated" style="@style/UsageWidgetFootnote"
        android:text="@string/widget_no_update" />
</LinearLayout>

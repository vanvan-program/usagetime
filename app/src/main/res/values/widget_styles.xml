<resources>
    <style name="UsageWidgetRoot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/widget_background</item>
    </style>
    <style name="UsageWidgetText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#625B72</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="UsageWidgetTotal" parent="UsageWidgetText">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#242133</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">16sp</item>
        <item name="android:autoSizeMaxTextSize">28sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="UsageWidgetFootnote" parent="UsageWidgetText">
        <item name="android:textSize">11sp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">16dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
